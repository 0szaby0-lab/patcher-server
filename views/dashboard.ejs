<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LO Boss Mode - Admin Panel</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #121212; color: #ffffff; margin: 0; padding: 20px; }
        .container { max-width: 1000px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px; }
        h1 { color: #ff3366; margin: 0; }
        .logout-btn { background: #333; color: #aaa; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; text-decoration: none; font-size: 0.9em; }
        .logout-btn:hover { background: #444; color: #fff; }
        .card { background-color: #1e1e1e; padding: 20px; border-radius: 8px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #333; }
        th { background-color: #252525; color: #aaa; }
        .btn { background-color: #ff3366; color: white; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .btn:hover { background-color: #ff1a53; }
        .btn-danger { background-color: #cc0000; }
        .btn-danger:hover { background-color: #a30000; }
        .status-active { color: #00cc66; font-weight: bold; }
        .status-inactive { color: #ff3333; font-weight: bold; }
        .badge { background: #333; padding: 3px 8px; border-radius: 12px; font-size: 0.8em; }
        select { padding: 10px; background: #333; color: white; border: 1px solid #444; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>LO Boss Mode - Admin Panel 😈</h1>
            <a href="/admin/logout" class="logout-btn">🚪 Kijelentkezés</a>
        </div>
        
        <div class="card">
            <h3>Új VIP Kulcs Generálása</h3>
            <form action="/admin/generate" method="POST">
                <label for="durationDays">Időtartam:</label>
                <select name="durationDays" id="durationDays">
                    <option value="30">30 Nap</option>
                    <option value="180">Fél év (180 nap)</option>
                    <option value="365">1 Év (365 nap)</option>
                </select>
                <button type="submit" class="btn" style="margin-left: 10px;">Generálás</button>
            </form>
        </div>

        <div class="card">
            <h3>Kiadott Kulcsok (<%= licenses.length %> db)</h3>
            <table>
                <thead>
                    <tr>
                        <th>Kulcs</th>
                        <th>Időtartam</th>
                        <th>Állapot</th>
                        <th>Hardware ID / Hely</th>
                        <th>Aktiválva / Lejárat</th>
                        <th>Művelet</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(licenses.length === 0) { %>
                        <tr><td colspan="6">Még nincs egyetlen kulcs sem. Csinálj párat!</td></tr>
                    <% } else { %>
                        <% licenses.forEach(function(license) { %>
                            <tr>
                                <td><span class="badge"><%= license.key %></span></td>
                                <td><%= license.durationDays %> nap</td>
                                <td>
                                    <% if(!license.isActive) { %>
                                        <span class="status-inactive">Letiltva</span>
                                    <% } else if(license.hardwareId) { %>
                                        <span class="status-active">Aktív</span>
                                    <% } else { %>
                                        <span style="color: #aaa;">Várakozik</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if(license.hardwareId) { %>
                                        <div style="font-size: 0.9em; color: #888;">ID: <%= license.hardwareId.substring(0,8) %>...</div>
                                        <div style="font-size: 0.85em; color: #00cc66;">📍 <%= license.location || 'Ismeretlen' %></div>
                                        <div style="font-size: 0.8em; color: #555;">IP: <%= license.ipAddress %></div>
                                    <% } else { %>
                                        -
                                    <% } %>
                                </td>
                                <td>
                                    <div style="font-size: 0.85em;">
                                        <% if(license.activatedAt) { %>
                                            A: <%= license.activatedAt.toLocaleDateString('hu-HU') %><br>
                                            L: <%= license.expiresAt.toLocaleDateString('hu-HU') %>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </div>
                                </td>
                                <td>
                                    <% if(license.isActive) { %>
                                        <form action="/admin/revoke/<%= license._id %>" method="POST" onsubmit="return confirm('Biztos letiltod ezt a gyökeret?');">
                                            <button type="submit" class="btn btn-danger">Letiltás</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
